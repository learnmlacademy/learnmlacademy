# Optional newsletter integration. Set secrets in Vercel Environment Variables;
# never put a real API key in this file or commit production secrets.
BREVO_API_KEY=replace-with-your-Brevo-API-key
BREVO_LIST_ID=replace-with-your-Brevo-list-id

# Optional server-side contact form delivery. BREVO_SENDER_EMAIL must be verified in Brevo.
BREVO_SENDER_EMAIL=replace-with-a-verified-sender-email
BREVO_SENDER_NAME=LearnMLAcademy
CONTACT_RECIPIENT_EMAIL=machinelearningacademy83@gmail.com

# Optional distributed rate limiting for /api/contact and /api/newsletter across serverless instances.
# When omitted, an in-memory sliding-window limiter is used automatically.
# Upstash Redis / Vercel KV REST credentials:
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-redis-rest-token

